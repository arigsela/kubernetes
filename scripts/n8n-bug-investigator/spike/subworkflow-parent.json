      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "8b3c4d5e-0000-4000-8000-000000000013",
      "name": "Pick issue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Busy on even minutes, idle (no items) on odd ones; a manual run is always busy.\nconst m = new Date().getUTCMinutes();\nif ($('Every minute').isExecuted && m % 2 === 1) return [];\nreturn [{json: {issue: {number: 1}, minute: m}}];\n"
      }
    },
    {
      "id": "8b3c4d5e-0000-4000-8000-000000000014",
      "name": "Investigate issue",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [
        440,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "spike-child"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {}
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Pick issue",
            "type": "main",
            "index": 0
          }
        ]
