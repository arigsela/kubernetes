<mxfile host="drawio" type="device"><diagram id="hk-demo" name="hk demo in the cluster"><mxGraphModel dx="1960" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;hk demo: how one question moves through the cluster&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5c6773;fontSize=20;fontColor=#1b2733;" vertex="1" parent="1"><mxGeometry x="220" y="6" width="1510" height="30" as="geometry"/></mxCell><mxCell id="subtitle" value="Browser → ① Gateway → ② login → ③ the app → ④ identity check → ⑤ kagent → ⑥ sandbox → ⑦ model API and ⑧ tools. An &lt;i&gt;implementer:&lt;/i&gt; turn takes the same path and ends in a pull request on GitHub." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5c6773;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="38" width="1510" height="24" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b&gt;Presenter&#x27;s browser&lt;/b&gt;&lt;br&gt;hk-demo.arigsela.com" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#495057;strokeWidth=1.5;fontSize=12;fontColor=#1b2733;" vertex="1" parent="1"><mxGeometry x="20" y="185" width="170" height="80" as="geometry"/></mxCell><mxCell id="ghlogin" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;sign-in (Dex&#x27;s connector)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#495057;strokeWidth=1.5;fontSize=12;fontColor=#1b2733;" vertex="1" parent="1"><mxGeometry x="20" y="405" width="170" height="75" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Key&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#1c7ed6&#x27;&gt;&lt;b&gt;━━▶&lt;/b&gt;&lt;/font&gt; the request&lt;br&gt;&lt;font color=&#x27;#e8590c&#x27;&gt;&lt;b&gt;━━▶&lt;/b&gt;&lt;/font&gt; the pull request&lt;br&gt;&lt;font color=&#x27;#868e96&#x27;&gt;- - -▷&lt;/font&gt; evidence the page reads&lt;br&gt;&lt;font color=&#x27;#c99a06&#x27;&gt;■&lt;/font&gt; configuration&lt;br&gt;&lt;br&gt;&lt;b&gt;Numbers = the page&#x27;s eight boxes&lt;/b&gt;&lt;br&gt;① Gateway&lt;br&gt;② Login&lt;br&gt;③ hk demo (the app)&lt;br&gt;④ Identity check&lt;br&gt;⑤ kagent&lt;br&gt;⑥ Sandbox&lt;br&gt;⑦ Model API&lt;br&gt;⑧ Tools" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ced4da;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#1b2733;" vertex="1" parent="1"><mxGeometry x="20" y="555" width="185" height="255" as="geometry"/></mxCell><mxCell id="cluster" value="homelab k3s cluster · Istio ambient mesh" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#326ce5;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#326ce5;" vertex="1" parent="1"><mxGeometry x="220" y="70" width="1510" height="820" as="geometry"/></mxCell><mxCell id="ns-ingress" value="ns istio-ingress" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a96a3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontSize=12;fontStyle=1;fontColor=#3b4754;" vertex="1" parent="1"><mxGeometry x="245" y="115" width="270" height="200" as="geometry"/></mxCell><mxCell id="gateway" value="&lt;b&gt;Gateway&lt;/b&gt; &lt;i&gt;main&lt;/i&gt; (Gateway API)&lt;br&gt;TLS for hk-demo.arigsela.com&lt;br&gt;&lt;i&gt;gateway-allow&lt;/i&gt;: only allow-listed IPs&lt;br&gt;Coraza WAF" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326ce5;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="260" y="145" width="240" height="155" as="geometry"/></mxCell><mxCell id="ns-dex" value="ns dex" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a96a3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontSize=12;fontStyle=1;fontColor=#3b4754;" vertex="1" parent="1"><mxGeometry x="245" y="355" width="270" height="155" as="geometry"/></mxCell><mxCell id="dex" value="&lt;b&gt;Dex&lt;/b&gt; · dex.arigsela.com&lt;br&gt;OIDC provider&lt;br&gt;static client &lt;i&gt;hk-demo&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326ce5;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="260" y="385" width="240" height="110" as="geometry"/></mxCell><mxCell id="ns-hk" value="ns hk-demo" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a96a3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontSize=12;fontStyle=1;fontColor=#3b4754;" vertex="1" parent="1"><mxGeometry x="540" y="115" width="300" height="345" as="geometry"/></mxCell><mxCell id="pod" value="pod hk-demo (one replica)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8a96a3;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#5c6773;" vertex="1" parent="1"><mxGeometry x="555" y="145" width="270" height="300" as="geometry"/></mxCell><mxCell id="oauth2" value="&lt;b&gt;oauth2-proxy&lt;/b&gt; :4180 (the only way in)&lt;br&gt;Dex login · one allowed email&lt;br&gt;adds X-Forwarded-Email" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326ce5;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="570" y="172" width="240" height="80" as="geometry"/></mxCell><mxCell id="app" value="&lt;b&gt;hk demo app&lt;/b&gt; · 127.0.0.1:8000&lt;br&gt;records who asked&lt;br&gt;calls the agent (A2A), streams progress&lt;br&gt;builds each box&#x27;s evidence" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326ce5;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="570" y="287" width="240" height="100" as="geometry"/></mxCell><mxCell id="sa" value="SA &lt;i&gt;hk-demo&lt;/i&gt;: projected token,&lt;br&gt;audience &lt;i&gt;kagent&lt;/i&gt;, 1 h" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=1.5;fontSize=10;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="570" y="395" width="175" height="42" as="geometry"/></mxCell><mxCell id="ns-kagent" value="ns kagent" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a96a3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontSize=12;fontStyle=1;fontColor=#3b4754;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="640" height="500" as="geometry"/></mxCell><mxCell id="templates" value="&lt;b&gt;AgentTemplates&lt;/b&gt; (admission checks the class)&lt;br&gt;&lt;i&gt;homelab-knowledge&lt;/i&gt;: class &lt;b&gt;read&lt;/b&gt;&lt;br&gt;&lt;i&gt;implementer&lt;/i&gt;: class &lt;b&gt;propose&lt;/b&gt; (branches and PRs, never merges)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#c99a06;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="880" y="135" width="320" height="90" as="geometry"/></mxCell><mxCell id="waypoint" value="&lt;b&gt;kagent-waypoint&lt;/b&gt;&lt;br&gt;verifies the SA token&lt;br&gt;(&lt;i&gt;kagent-callers&lt;/i&gt;)&lt;br&gt;caller =&lt;br&gt;system:serviceaccount:&lt;br&gt;hk-demo:hk-demo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326ce5;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="880" y="250" width="145" height="140" as="geometry"/></mxCell><mxCell id="controller" value="&lt;b&gt;kagent controller&lt;/b&gt; :8083&lt;br&gt;A2A /agents/kagent/&amp;lt;agent&amp;gt;&lt;br&gt;sessions and tasks (Postgres)&lt;br&gt;&lt;i&gt;contextId&lt;/i&gt; continues a session" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326ce5;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="1050" y="250" width="150" height="140" as="geometry"/></mxCell><mxCell id="workers" value="&lt;b&gt;worker pods&lt;/b&gt; (ateom-gvisor)&lt;br&gt;one actor per session,&lt;br&gt;in a gVisor sandbox&lt;br&gt;runs hk or implementer&lt;br&gt;(Go ADK)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326ce5;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="880" y="425" width="180" height="150" as="geometry"/></mxCell><mxCell id="tools" value="MCP tool servers" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#e6ebf1;strokeColor=#8a96a3;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontSize=11;fontStyle=1;fontColor=#3b4754;" vertex="1" parent="1"><mxGeometry x="1225" y="125" width="260" height="420" as="geometry"/></mxCell><mxCell id="agentdocs" value="&lt;b&gt;agent-docs&lt;/b&gt; (hk)&lt;br&gt;agentgateway allow-list →&lt;br&gt;github-mcp-server, read-only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326ce5;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="1240" y="152" width="230" height="78" as="geometry"/></mxCell><mxCell id="implmcp" value="&lt;b&gt;implementer-mcp&lt;/b&gt; (implementer)&lt;br&gt;agentgateway allow-list →&lt;br&gt;github-mcp-server as the App&lt;br&gt;&lt;i&gt;arigsela-implementer&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326ce5;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="1240" y="240" width="230" height="88" as="geometry"/></mxCell><mxCell id="brave" value="&lt;b&gt;brave-search&lt;/b&gt; (hk)&lt;br&gt;agentgateway allow-list →&lt;br&gt;web search" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326ce5;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="1240" y="338" width="230" height="70" as="geometry"/></mxCell><mxCell id="k8stools" value="&lt;b&gt;kagent-tool-server&lt;/b&gt; (both)&lt;br&gt;read-only Kubernetes tools&lt;br&gt;(RBAC: no Secrets)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326ce5;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="1240" y="418" width="230" height="70" as="geometry"/></mxCell><mxCell id="toolsnote" value="The allow-list logs each call it lets through: that line is the Tools box&#x27;s ✓." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5c6773;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1240" y="494" width="235" height="46" as="geometry"/></mxCell><mxCell id="ns-backstage" value="ns backstage" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a96a3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontSize=12;fontStyle=1;fontColor=#3b4754;" vertex="1" parent="1"><mxGeometry x="1515" y="380" width="200" height="160" as="geometry"/></mxCell><mxCell id="backstage" value="&lt;b&gt;Backstage&lt;/b&gt;&lt;br&gt;MCP actions endpoint&lt;br&gt;&lt;i&gt;backstage-catalog&lt;/i&gt;:&lt;br&gt;get-catalog-entity (hk)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326ce5;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="1530" y="410" width="170" height="115" as="geometry"/></mxCell><mxCell id="ns-ate" value="ns ate-system · Agent Substrate" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a96a3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontSize=12;fontStyle=1;fontColor=#3b4754;" vertex="1" parent="1"><mxGeometry x="860" y="625" width="640" height="240" as="geometry"/></mxCell><mxCell id="router" value="&lt;b&gt;atenet-router&lt;/b&gt;&lt;br&gt;sends each turn to&lt;br&gt;its session&#x27;s actor" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326ce5;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="880" y="660" width="130" height="75" as="geometry"/></mxCell><mxCell id="apiserver" value="&lt;b&gt;ate-api-server&lt;/b&gt;&lt;br&gt;CreateActor /&lt;br&gt;ResumeActor" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326ce5;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="1100" y="660" width="120" height="75" as="geometry"/></mxCell><mxCell id="atelet" value="&lt;b&gt;atelet&lt;/b&gt; (every node)&lt;br&gt;snapshots idle actors,&lt;br&gt;restores them" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326ce5;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="880" y="770" width="130" height="80" as="geometry"/></mxCell><mxCell id="rustfs" value="&lt;b&gt;rustfs&lt;/b&gt;&lt;br&gt;snapshot store&lt;br&gt;(S3 API)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326ce5;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="1100" y="770" width="120" height="80" as="geometry"/></mxCell><mxCell id="egress" value="&lt;b&gt;atenet-egress&lt;/b&gt;&lt;br&gt;every call out of a sandbox goes here&lt;br&gt;per-actor egress policy&lt;br&gt;adds the Anthropic key and tool tokens&lt;br&gt;(&lt;i&gt;ate-secret://&lt;/i&gt;), so the sandbox&lt;br&gt;never holds them" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326ce5;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="1240" y="660" width="245" height="190" as="geometry"/></mxCell><mxCell id="ns-obs" value="ns tracing · ns logging (the evidence)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a96a3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontSize=12;fontStyle=1;fontColor=#3b4754;" vertex="1" parent="1"><mxGeometry x="245" y="555" width="595" height="310" as="geometry"/></mxCell><mxCell id="collector" value="&lt;b&gt;OTel collector&lt;/b&gt;&lt;br&gt;agent, Substrate and tool spans" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#868e96;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="265" y="595" width="170" height="60" as="geometry"/></mxCell><mxCell id="tempo" value="&lt;b&gt;Tempo&lt;/b&gt;&lt;br&gt;traces (7 days)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#868e96;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="470" y="595" width="150" height="60" as="geometry"/></mxCell><mxCell id="alloy" value="&lt;b&gt;Alloy&lt;/b&gt; (every node)&lt;br&gt;pod logs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#868e96;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="265" y="685" width="170" height="60" as="geometry"/></mxCell><mxCell id="loki" value="&lt;b&gt;Loki&lt;/b&gt;&lt;br&gt;logs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#868e96;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="470" y="685" width="150" height="60" as="geometry"/></mxCell><mxCell id="prom" value="&lt;b&gt;Prometheus&lt;/b&gt;&lt;br&gt;metrics, cost totals" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#868e96;strokeWidth=1.5;fontSize=11;fontColor=#1b2733;spacing=4;" vertex="1" parent="1"><mxGeometry x="655" y="640" width="165" height="60" as="geometry"/></mxCell><mxCell id="obsnote" value="The page&#x27;s ✓ and ✗ come from here: the turn&#x27;s trace (by task id), its log lines (Gateway, waypoint, kagent, Substrate, tool servers) and cost totals. The app only reads (GET)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5c6773;" vertex="1" parent="1"><mxGeometry x="265" y="770" width="560" height="80" as="geometry"/></mxCell><mxCell id="github" value="&lt;b&gt;github.com&lt;/b&gt;&lt;br&gt;arigsela/kubernetes&lt;br&gt;(reads the repo, opens PRs)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#495057;strokeWidth=1.5;fontSize=12;fontColor=#1b2733;" vertex="1" parent="1"><mxGeometry x="1760" y="160" width="180" height="110" as="geometry"/></mxCell><mxCell id="anthropic" value="&lt;b&gt;api.anthropic.com&lt;/b&gt;&lt;br&gt;Claude Sonnet 5.5" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#495057;strokeWidth=1.5;fontSize=12;fontColor=#1b2733;" vertex="1" parent="1"><mxGeometry x="1760" y="710" width="180" height="90" as="geometry"/></mxCell><mxCell id="e-browser" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;strokeColor=#1c7ed6;fontColor=#1c7ed6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.516;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="gateway"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-gw" value="HBONE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;strokeColor=#1c7ed6;fontColor=#1c7ed6;exitX=1;exitY=0.432;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="oauth2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-oidc" value="OIDC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;labelBackgrou